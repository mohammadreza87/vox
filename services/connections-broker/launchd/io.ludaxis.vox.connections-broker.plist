<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.ludaxis.vox.connections-broker</string>
  <key>UserName</key><string>vox-broker</string>
  <key>GroupName</key><string>vox-broker</string>
  <key>WorkingDirectory</key><string>/opt/vox</string>
  <key>ProgramArguments</key><array>
    <string>/opt/vox/runtime/node</string><string>--import</string><string>tsx</string>
    <string>/opt/vox/scripts/connections-broker.mjs</string><string>serve</string>
    <string>/usr/local/etc/vox-connections-broker/config.json</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>NODE_ENV</key><string>production</string>
    <key>PATH</key><string>/usr/bin:/bin</string>
  </dict>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>20</integer>
  <key>HardResourceLimits</key><dict>
    <key>NumberOfFiles</key><integer>512</integer>
    <key>NumberOfProcesses</key><integer>64</integer>
  </dict>
  <key>StandardOutPath</key><string>/usr/local/var/log/vox-connections-broker/stdout.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/vox-connections-broker/stderr.log</string>
</dict>
</plist>
