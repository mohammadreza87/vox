{
  "name": "vox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:dd": "dotenv -e .env.local -- node --import dd-trace/initialize.mjs ./node_modules/.bin/next dev",
    "build": "next build",
    "start": "next start",
    "start:dd": "dotenv -e .env.local -- node --import dd-trace/initialize.mjs ./node_modules/.bin/next start",
    "lint": "eslint",
    "check:studio-style": "node scripts/check-studio-style.mjs",
    "check:pet-bundle": "node scripts/check-pet-bundle.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tireh:local": "dotenv -e .env.local -- tsx scripts/tireh-local.ts",
    "studio:start": "STUDIO_BOTS=1 next start",
    "studio:build": "node scripts/studio-build.mjs",
    "studio:production": "node scripts/studio-production.mjs",
    "test:relationships": "vitest run src/lib/relationships src/lib/studio/__tests__/relationships.test.ts src/lib/studio/__tests__/scoped-relationship-integration.test.ts src/lib/studio/__tests__/scoped-relationship-drain.test.ts src/lib/adaptive/__tests__/relationships-service.test.ts src/lib/tireh/__tests__/memory-privacy.test.ts src/app/api/studio/relationships/drain/route.test.ts src/app/studio/_components/RelationshipPanel.test.tsx",
    "simulate:relationships": "tsx scripts/relationship-simulation.ts",
    "eval:voice": "node --import tsx scripts/agent-voice-eval.ts",
    "eval:skills": "node --import tsx scripts/skill-routing-eval.ts",
    "timings:report": "node --import tsx scripts/stage-timings.ts",
    "e2e:relationships": "playwright test --config=playwright.relationships.config.ts",
    "test:connections": "vitest run src/lib/connections",
    "e2e:connections": "playwright test --config=playwright.connections.config.ts",
    "connections:broker": "node --import tsx scripts/connections-broker.mjs",
    "connections:config": "node --import tsx scripts/connections-config.mjs",
    "connections:preflight": "node --import tsx scripts/connections-preflight.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@elevenlabs/client": "^0.16.0",
    "@elevenlabs/react": "^0.15.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.2",
    "@stripe/stripe-js": "^8.11.0",
    "@tanstack/react-query": "^5.104.5",
    "@telegram-apps/telegram-ui": "^2.1.13",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-sqlite3": "13.0.3",
    "clsx": "^2.1.1",
    "dd-trace": "^5.132.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "openai": "^7.43.0",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.4",
    "@playwright/test": "^1.64.1",
    "@sentry/nextjs": "^10.32.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "4.1.12",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "eslint-plugin-storybook": "^10.6.3",
    "jsdom": "^27.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.57.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^7.2.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
}
